# Frontend build variables (Vercel, Netlify, Cloudflare Pages, or local .env)
#
# Every value here is baked into the JavaScript bundle at BUILD time.
# Changing one requires a new deployment, not just a restart.

# ---------------------------------------------------------------- API location
# Leave EMPTY when FastAPI serves this frontend and the API lives on the same
# origin (the /api path is then used automatically).
# Set it when the API is deployed separately, for example on Render:
#   VITE_API_URL=https://doc-master-api.onrender.com
VITE_API_URL=

# ------------------------------------------------------------------ Public URL
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# Strongly recommended when the frontend is hosted separately, because the
# backend can no longer rewrite the placeholder origin for you.
#   VITE_SITE_URL=https://your-domain.com
VITE_SITE_URL=

# -------------------------------------------------------------------- Analytics
# Optional. Leave empty to collect nothing.
#   G-XXXXXXXXXX   -> Google Analytics 4
#   your-domain.com -> Plausible Cloud
VITE_ANALYTICS_ID=