# ------------------------------------------------------------------ server
PORT=8000

# Largest single upload in megabytes.
MAX_FILE_MB=25

# Largest total request body in megabytes (merge + convert jobs send many files).
MAX_TOTAL_MB=120

# Maximum number of files in one request.
MAX_FILES=20

# Comma separated list of browser origins allowed to call the API.
# Use your own domain in production, for example: https://docmaster.app
# When the frontend is on Vercel, put the Vercel domain here.
ALLOWED_ORIGINS=http://localhost:5173

# Optional regular expression for extra origins, useful for Vercel preview
# deployments whose subdomains change on every push:
#   ALLOWED_ORIGIN_REGEX=https://doc-master.*\.vercel\.app
# ALLOWED_ORIGIN_REGEX=

# Set to * to allow any origin. The API is public, sends no cookies and never
# uses credentials, so this is safe but less tidy than naming your domains.
# ALLOWED_ORIGINS=*

# Public origin of the site. Used for canonical URLs, the sitemap and analytics
# when this service serves the frontend.
SITE_URL=https://docmaster.example

# Analytics identifier. Leave empty to collect nothing.
#   G-XXXXXXXXXX   -> Google Analytics 4
#   your-site.com  -> Plausible Cloud (defaults to the host of SITE_URL)
ANALYTICS_ID=

# Rate limit applied to every /api endpoint, and to each tool separately.
RATE_LIMIT=20/minute

# Where the built frontend lives. Only needed when it is not at frontend/dist.
# FRONTEND_DIST=/app/dist

# ------------------------------------------------------------------ frontend
# These are baked into the bundle at build time and belong to the FRONTEND
# project (see frontend/.env.example). Repeat them here only if this service
# also serves the built frontend.
#   VITE_API_URL=https://doc-master-api.onrender.com
#   VITE_SITE_URL=https://your-domain.com
#   VITE_ANALYTICS_ID=G-XXXXXXXXXX