# ------------------------------------------------------------------ server
PORT=8000

# Largest single upload in megabytes.
MAX_FILE_MB=25

# Largest total request body in megabytes (merge + convert jobs send many files).
MAX_TOTAL_MB=120

# Maximum number of files in one request.
MAX_FILES=20

# Comma separated list of browser origins allowed to call the API.
# Use your own domain in production, for example: https://docmaster.app
ALLOWED_ORIGINS=http://localhost:5173

# Public origin of the site. Used for canonical URLs, the sitemap and analytics.
SITE_URL=https://docmaster.example

# Analytics identifier. Leave empty to collect nothing.
#   G-XXXXXXXXXX   -> Google Analytics 4
#   your-site.com  -> Plausible Cloud (defaults to the host of SITE_URL)
ANALYTICS_ID=

# Rate limit applied to every /api endpoint, and to each tool separately.
RATE_LIMIT=20/minute

# Where the built frontend lives. Only needed when it is not at frontend/dist.
# FRONTEND_DIST=/app/dist